{
  "gitignore": true,
  "globs": [
    "**/*.md",

    //Exclude AI prompt files - they are not traditional doc pages.
    "!.github/prompts/**/*.md"
  ],

  "config": {
    // Don't enforce maximum line length.
    "MD013": false,
    // Don't enforce ordered list item prefix
    "MD029": false
  }
}
